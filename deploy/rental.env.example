# Copy to /etc/longyuan-rental.env, set ownership/mode 600; never commit real values.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
SKY_DB_URL=jdbc:mysql://127.0.0.1:3306/longyuan_rental?serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=utf-8&useSSL=false&allowPublicKeyRetrieval=true
SKY_DB_DATABASE=longyuan_rental
SKY_DB_USERNAME=rental_app
SKY_DB_PASSWORD=replace-with-database-password
SKY_REDIS_HOST=127.0.0.1
SKY_REDIS_PORT=6379
SKY_REDIS_PASSWORD=replace-with-redis-password
RENTAL_JWT_SECRET=replace-with-at-least-32-random-bytes
SKY_ADMIN_JWT_SECRET=replace-with-a-different-random-secret
SKY_UPLOAD_PATH=/var/lib/longyuan-rental/uploads
RENTAL_ASSISTANT_ENABLED=false
# Enable only after verifying the server network, account balance and model responses.
# RENTAL_ASSISTANT_ENABLED=true
# RENTAL_ASSISTANT_ENDPOINT=https://api.deepseek.com/chat/completions
# RENTAL_ASSISTANT_MODEL=deepseek-flash
# RENTAL_ASSISTANT_TOKEN_FIELD=max_tokens
# RENTAL_ASSISTANT_API_KEY=fill-on-server-only
# RENTAL_ASSISTANT_DISABLE_THINKING=true
# RENTAL_ASSISTANT_PROXY_URL=  # Normally empty; never copy your PC's localhost proxy.
