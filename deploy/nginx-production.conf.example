# Install inside nginx http{} as a site; replace domain, certificate and root paths.
server {
    listen 80;
    server_name rental.example.com;
    location /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name rental.example.com;
    ssl_certificate /etc/letsencrypt/live/rental.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rental.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/longyuan-rental/web;
    index index.html;
    client_max_body_size 3m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;
    location /rental/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
    location /images/ {
        proxy_pass http://127.0.0.1:8080;
        limit_except GET HEAD { deny all; }
    }
    location ~ ^/(user|doc.html|swagger|v2|webjars)(/|$) { return 404; }
    location ~ (^|/)\. { deny all; }
    location / { try_files $uri $uri/ /index.html; }
}
