# Independent site example; do not overwrite the existing takeaway site.
server {
    listen 8082;
    server_name localhost;
    root C:/path/to/sky-take-out/frontend/rental-web/dist;
    index index.html;
    client_max_body_size 3m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    location /rental/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location /images/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
    # The rental demo does not expose legacy takeaway or Swagger endpoints.
    location ~ ^/(user|doc.html|swagger|v2|webjars)(/|$) { return 404; }
    location ~ (^|/)\. { deny all; }
}
