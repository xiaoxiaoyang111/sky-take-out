# Independent site example; do not overwrite the existing takeaway site.
server {
    listen 8082;
    server_name localhost;
    root C:/path/to/sky-take-out/frontend/rental-web/dist;
    index index.html;
    client_max_body_size 3m;

    location /rental/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /images/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
